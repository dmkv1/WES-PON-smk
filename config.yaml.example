# Every /path/to/... below is a placeholder. Repoint them at this host before the
# first run. Every reference and BED path must sit under refs.path, because the
# Snakefile builds the container bind mount from exactly that root.
#
# Samplesheet columns: ID,sample,gender,capture_kit,fq1,fq2. fq1/fq2 may be a
# literal path or a lane glob; a glob becomes one alignment unit per pair. The
# calling pipeline's extra columns (sample_type, tumor_fraction) are accepted and
# ignored -- every sample here is a normal -- so one generated sheet feeds both
# pipelines. Nothing here reads a catalogue: any sheet with these columns works,
# including a hand-written one.
samplesheet: "samplesheet.csv"
outdir: "results"

telegram_bot_env: ""  # Path to .telegram_bot.env file; leave empty to disable notifications
run_id: ""            # Human-readable label prepended to Telegram notifications, e.g. "pon"

# Container images (pinned), matching WES-snakemake so PON normals and caller
# tumors run the same GATK build. Referenced per rule as config["containers"][...].
containers:
  gatk: "docker://broadinstitute/gatk:4.6.2.0"
  cnvkit: "docker://etal/cnvkit:0.9.14"
  purecn: "docker://markusriester/purecn:2.10.0-amd64"

refs:
  # Root directory bound into containers (APPTAINER_BIND/SINGULARITY_BIND, set
  # in the Snakefile); every path below must resolve under it.
  path: "/path/to/refs"
  genome_human: "/path/to/refs/broad/Homo_sapiens_assembly38.fasta"
  refflat: "/path/to/refs/UCSC/refFlat.txt"
  # BQSR known sites — flat list; GATK resolves .idx/.tbi siblings automatically
  known_sites:
    - "/path/to/refs/broad/Homo_sapiens_assembly38.dbsnp138.vcf"
    - "/path/to/refs/broad/Homo_sapiens_assembly38.known_indels.vcf.gz"
    - "/path/to/refs/broad/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

# Keys here become the {probes} wildcard value in output filenames, and are the
# names WES-snakemake's panel_of_normals paths point at.
#   capture_kit            — the token the samplesheet's capture_kit column uses
#                            for this kit. Keeping it separate from the key means
#                            a deployment whose sheet spells its kits differently
#                            edits this config rather than any code.
# Each probe type points at the original Agilent kit BED files (with their
# browser/track header lines — the GATK tools and mosdepth skip those; CNVkit's
# header is stripped in-rule):
#   covered_bedfile        — the "Covered" BED (regions covered by probes). This
#                            is the primary interval set: drives BQSR --intervals,
#                            mosdepth, Mutect2/GenomicsDBImport, CNVkit autobin,
#                            and the HsMetrics baits.
#   target_regions_bedfile — the "Regions" BED; used only as HsMetrics
#                            TARGET_INTERVALS (for V6+UTR Agilent ships this
#                            identical to Covered).
probe_configs:
  SureSelectV6UTR:
    capture_kit: "V6+UTR"
    covered_bedfile: "/path/to/refs/SureSelectHumanAllExon/V6UTR/S07604624_Covered.bed"
    target_regions_bedfile: "/path/to/refs/SureSelectHumanAllExon/V6UTR/S07604624_Regions.bed"
  SureSelectV8UTR:
    capture_kit: "V8+UTR"
    covered_bedfile: "/path/to/refs/SureSelectHumanAllExon/V8UTR/S33613271_Covered.bed"
    target_regions_bedfile: "/path/to/refs/SureSelectHumanAllExon/V8UTR/S33613271_Regions.bed"

# Sized for a 16-thread, 64 GB host, which is the common 4 GB per thread server
# ratio. Scale every value with the machine, together with cores and
# resources.mem_mb in profiles/default/config.yaml. The budget:
#
#   64 GB total, of which the profile offers 56 GB to the scheduler.
#   One GATK job holds 40 GB (32 GB heap + 25% non-heap), so GATK rules run one
#   at a time and roughly 16 GB stays free for the small rules beside them.
resources:
  threads: 16
  java_max_gb: 32
  java_min_gb: 8       # start small; the JVM grows to java_max_gb on demand
  mem_mb: 40960        # java_max_gb + 25% non-heap overhead, for scheduler tracking
  # Per-thread sort buffer for `samtools sort`. Set explicitly because the
  # samtools default (768M) is per thread, so it scales with -@ into a spike far
  # larger than intended. sort_bam declares sort_mem x threads to the scheduler,
  # so 1G x 16 threads = 16 GB for the sort itself.
  sort_mem: "1G"

params:
  rg:
    # Read-group resolution: how to treat a samplesheet that contradicts the
    # data (flowcell, or a lane that disagrees with the filename or the reads).
    # true here, unlike a routine caller run: a degraded read group in a normal
    # is baked into every PON artifact built from it and is never revisited.
    strict: true
  fastp:
    detect_adapter_for_pe: true
  bqsr:
    # Restrict BaseRecalibrator to the capture target (+padding). Must match the
    # calling pipeline's BQSR intervals for the PON normals to stay comparable.
    interval_padding: 100
  cnvkit:
    use_offtarget: false
    autobin:
      method: "hybrid"
      bp_per_bin: 100000
      target_min_size: 20
      target_max_size: 20000
      antitarget_min_size: 500
      antitarget_max_size: 500000

# Snakemake run settings. Copy to config.yaml in this directory before the first
# run; launch.sh passes --profile profiles/default and snakemake reads only
# config.yaml. The example is tracked, the working copy is not, so host capacity
# stays out of git.

# Total Snakemake CPU cores cap. Sized for a 16-thread, 64 GB machine. Raise
# both this and the memory budget below to match a larger host, together with
# the resources block in config.yaml.
cores: 16

# Memory budget, in MB. Rules that declare mem_mb are scheduled against this
# ceiling; without it the scheduler packs by cores alone and can start a
# full-size GATK job (40 GB) beside a samtools sort (~19 GB) beside another
# GATK job. 56 GB of the 64 GB total: the rest stays with the OS and the page
# cache.
#
# io_heavy caps the rules that read a whole BAM and write a whole BAM
# (mark_duplicates, apply_bqsr), which each declare io_heavy=1. Their memory
# tiers alone would let many run at once; on spinning disks that many concurrent
# whole-BAM rewrites turn into seek thrash rather than throughput. Raise it on
# NVMe, lower it on a single disk.
resources:
  mem_mb: 57344
  io_heavy: 4

# What a rule gets when it declares no mem_mb of its own: fastp, fastqc,
# mosdepth, cnvkit coverage. Small, but not free.
default-resources:
  mem_mb: 4000

use-conda: true
use-singularity: true
keep-going: true
rerun-incomplete: true
printshellcmds: true
